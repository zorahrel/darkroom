# Darkroom configuration — copy to .env and adjust. All values are optional;
# the defaults shown make Darkroom store everything under ~/Darkroom.

# --- Storage --------------------------------------------------------------
# Root folder for gallery data + the SQLite DB.
# GALLERY_ROOT=~/Darkroom
# Override individual locations if you want (default: <root>/data/<name>):
# GALLERY_DATA_DIR=
# GALLERY_RAW_DIR=          # originals to import (immutable)
# GALLERY_IMPORT_DIR=       # pre-existing renders to reconcile as "orphans"
# GALLERY_GEN_DIR=          # worker outputs
# GALLERY_FINAL_DIR=        # exported favorites
# GALLERY_LUT_DIR=          # .cube LUTs for the local color grade (default: <data>/luts)
# GALLERY_GRADED_DIR=       # on-disk cache for graded renders (default: <data>/graded)
# DARKROOM_DB=              # explicit path to photos.db
# Where projects YOU create from the Studio are put (one folder each):
# DARKROOM_PROJECTS_DIR=~/Darkroom/projects

# --- Local color grade (optional) ----------------------------------------
# The grade (LUT + AWB + pink pop) runs scripts/color_grade.py — needs python3
# with numpy + Pillow, plus ffmpeg on PATH. Override the ffmpeg binary with:
# FFMPEG=/opt/homebrew/bin/ffmpeg

# --- Quality checks (optional) -------------------------------------------
# The vision-model checks (garbled signage, deformed anatomy, watermarks) shell
# out to the Moondream CLI. Point this at the binary if it is not on PATH; the
# pixel checks (blown highlights, crushed blacks, near-duplicates) need only
# ffmpeg and always run.
# MOONDREAM_BIN=/usr/local/bin/moondream

# --- Server ---------------------------------------------------------------
# PORT=3535                 # backend (frontend dev server defaults to 5173)

# --- Backend selection ----------------------------------------------------
# WORKER_BACKEND=cdp        # "cdp" = ChatGPT web over CDP (default, free)
#                           # "codex" = Codex CLI (OAuth, no Chrome)
#                           # "codex-http" = endpoint della CLI Codex (allega i reference)
#                           # "openai" = Images API, A PAGAMENTO (vedi sotto)

# --- Backend OpenAI (opzionale, a pagamento) ------------------------------
# Serve quando la quota di un account interattivo non basta (una passata lunga)
# o quando serve testo leggibile dentro l'immagine: gpt-image-2 è l'unico che
# non produce lettere storte.
#
# La chiave NON si mette qui: questo file è in chiaro. Va nel Keychain:
#   security add-generic-password -s openai -a darkroom -w "<chiave>" -U
# (OPENAI_API_KEY nell'ambiente ha comunque la precedenza, per CI e test.)
#
# Costo misurato il 26/08 su 1024x1024: `high` ~7000 token = ~$0.21 a immagine
# (la tabella dei docs ne dava 4160: il numero vero lo riporta l'API in `usage`).
# `low` ~196 token = ~$0.006. Il batch dimezza: vedi scripts/openai_batch.ts.
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high   # high | medium | low
# OPENAI_IMAGE_SIZE=1024x1024

# --- ChatGPT-web (CDP) backend -------------------------------------------
# CHATGPT_CDP_PORT=19223
# CHATGPT_CDP_URL=http://127.0.0.1:19223
# CHROME_BIN=               # path to Chrome/Chromium if auto-detect fails
# DARKROOM_CHROME_PROFILE=  # persistent Chrome profile (holds the ChatGPT login)
# GEN_TIMEOUT_S=540         # max seconds to wait for one generation

# --- Codex backend (optional) --------------------------------------------
# CODEX_BIN=/Applications/Codex.app/Contents/Resources/codex

# --- Higgsfield backend (optional, paid) ---------------------------------
# Enable by completing the OAuth flow (writes data/higgsfield.json) or:
# HIGGSFIELD_ENABLED=1
