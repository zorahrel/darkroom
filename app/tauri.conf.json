{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darkroom",
  "version": "0.1.0",
  "identifier": "io.armonia.darkroom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Darkroom",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/128x128.png", "icons/32x32.png"],
    "copyright": "Copyright © 2026 Attilio Cianci",
    "category": "Photography",
    "shortDescription": "Culling e rifinitura, in locale",
    "longDescription": "Darkroom: si sceglie cosa vale la pena lavorare, poi lo si lavora. Le fotografie non lasciano il computer, tranne quando si chiede espressamente una rifinitura AI."
  }
}
