# Dependencies
node_modules/

# Build output
dist/

# Local data, DB and secrets — never commit these
data/
photos.db
photos.db-journal
photos.db-wal
photos.db-shm
*.backup-*
**/higgsfield.json

# Env / secrets
.env
.env.local

# Generated preview thumbnails (regenerate with scripts/gen_previews.ts)
client/public/previews/*
!client/public/previews/.gitkeep

# Logs
logs/
*.log

# Caches
.cache/
__pycache__/
*.pyc
scripts/.match_cache.json
scripts/.verify_cache.json

# OS
.DS_Store

# Local agent/session state (worktrees, memory, per-machine)
.claude/

# Compilazione del motore nativo
core/target/

# Compilazione dell'applicazione desktop
app/target/

# Le copertine come escono da ChatGPT: pesano un megabyte l'una e servono solo a
# rifare le versioni ridotte senza rigenerarle. Quelle ridotte sono in client/public.
.copertine-grezze/
